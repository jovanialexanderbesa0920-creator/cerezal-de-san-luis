rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si el usuario es Admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función para saber si el usuario es el dueño de la unidad (Residente)
    function isResidentOf(unitId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unidadId == unitId;
    }

    // 1. USUARIOS: Todos autenticados o no autenticados (para dropdown de acceso) pueden leer. Solo admin edita/elimina.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 2. DIRECTORIO
    match /directorio/{unitId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isResidentOf(unitId);
    }

    match /telefonos/{phoneId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 3. PAQUETES
    match /packages/{packageId} {
      allow read: if request.auth != null && (resource.data.unidad == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unidadId || isAdmin());
      allow write: if isAdmin() || request.auth != null; // Residents don't edit packages, but we'll stick to isAdmin for strictness, but wait, resident doesn't create packages either. Let's make it isAdmin().
    }

    // 4. VISITANTES Y PARQUEO
    match /visitors/{visitorId} {
      allow read, write: if request.auth != null;
    }

    match /vehicles/{vehicleId} {
      allow read, write: if request.auth != null;
    }

    match /visitor_slots/{slotId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // History / Movimientos
    match /movimientos/{movId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
